rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── ユーザープロフィール ──
    // 全員読める（グループメンバー表示のため）、書けるのは本人のみ
    match /asakatsu_users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ── グループ ──
    // 読み: 認証済みなら誰でも（コード検索のため）
    // 作成: 認証済みならOK
    // 更新: メンバーのみ（メンバー追加時など）
    match /asakatsu_groups/{groupId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null
        && request.auth.uid in resource.data.memberIds;
    }

    // ── スポット ──
    // 読み書き: 認証済みならOK（グループIDで絞り込みはアプリ側で担保）
    match /asakatsu_spots/{spotId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
    }

    // ── セッション ──
    // 読み: 認証済みなら誰でも（グループ全員の今日の状況表示のため）
    // 作成・更新: 本人のみ
    match /asakatsu_sessions/{sessionId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId;
      allow update: if request.auth != null
        && request.auth.uid == resource.data.userId;
    }
  }
}
